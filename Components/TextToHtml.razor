@using FIAB.Models
@using System.Text.RegularExpressions
@namespace FIAB.Components

@if(FormattedContent != null)
{
	@FormattedContent
}

@code
{
	[Parameter]
	[EditorRequired]
	public string? Value { get; set; }

	[Parameter]
	public EventCallback<string?> ValueChanged { get; set; }

	private RenderFragment? FormattedContent;

	protected override void OnParametersSet()
	{
		FormattedContent = TextAsHtml(Value ?? string.Empty);
	}
	
	private static string RemoveHtmlTags(string input)
	{
		var regex = new Regex("<[^>]*>", RegexOptions.Compiled);
		return regex.Replace(input, "");
	}

	private RenderFragment TextAsHtml(string input)
	{
		// Strip out any and all HTML tags, because the input is supposed to be plaintext.
		var cleanString = RemoveHtmlTags(input);
		// Convert newline characters to `<br/>` tags to display linebreaks.
		cleanString = cleanString.Replace("\n", "\n<br/>\n");
		
		return new RenderFragment(b => b.AddMarkupContent(0, cleanString));
	}
}